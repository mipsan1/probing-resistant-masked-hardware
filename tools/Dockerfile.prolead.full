# Dockerfile for PROLEAD d=2 verification
# Base: Ubuntu 24.04 (GCC 13, libflint 3.x, std::format support)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# 1. C++ toolchain + Boost 1.83 + libflint (apt)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        ca-certificates \
        curl \
        pkg-config \
        libboost-all-dev \
        libflint-dev \
        libgmp-dev \
        libmpfr-dev \
        libomp-dev \
        libglu1-mesa-dev \
        libpython3-dev \
        python3-dev \
        python3-pip \
        python3-numpy \
        time \
    && rm -rf /var/lib/apt/lists/*

# 2. The PROLEAD Makefile (release) targets `-fpermissive` but expects
# std::format, which requires GCC 13+. Ubuntu 24.04 ships GCC 13.4.
# 3. The vendor repo brings Boost 1.86 (gdstk requires <boost/json.hpp>);
#    we use system Boost 1.83 + vendor 1.86 headers as fallback.

WORKDIR /work

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
